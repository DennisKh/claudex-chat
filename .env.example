# Copy to .env — docker compose reads it automatically.

# Your Claude API key. Leave it unset and the app still starts, with the
# composer disabled and a banner explaining why.
ANTHROPIC_API_KEY=sk-ant-...

# The host directory the file tools may reach, mounted at /workspace in the
# container. Defaults to ./workspace. Point it at a project you want Claude to
# work on — it gets read and write access there, subject to your approval on
# every call.
# CLAUDEX_CHAT_WORKSPACE=/Users/you/code/some-project

# Host port to publish. Defaults to 4000.
# PORT=4000

# Generate with `mix phx.gen.secret`. The compose file has a throwaway default
# so the demo runs with no setup at all.
# SECRET_KEY_BASE=
